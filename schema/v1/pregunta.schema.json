{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camilomoreno/preguntas-icfes/schema/v1/pregunta.schema.json",
  "title": "Pregunta ICFES",
  "type": "object",
  "required": [
    "id",
    "competencia",
    "componente",
    "afirmacion",
    "evidencia",
    "estandar_asociado",
    "que_evalua",
    "contexto",
    "enunciado",
    "opciones"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único dentro del paquete. Estable entre ediciones; permite referenciar la misma pregunta desde otros sistemas (p. ej. entre versiones A/B de una evaluación)."
    },
    "competencia": { "type": "string", "minLength": 1 },
    "componente": { "type": "string", "minLength": 1 },
    "afirmacion": { "type": "string", "minLength": 1 },
    "evidencia": { "type": "string", "minLength": 1 },
    "estandar_asociado": { "type": "string", "minLength": 1 },
    "que_evalua": {
      "type": "string",
      "minLength": 1,
      "description": "Qué evalúa específicamente esta pregunta, en texto libre."
    },
    "contexto": {
      "type": "array",
      "items": { "$ref": "#/$defs/bloque" },
      "description": "Texto/imagen/tabla introductorios compartidos. Array vacío = sin contexto."
    },
    "enunciado": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bloque" }
    },
    "opciones": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/opcion" }
    },
    "grado": {
      "type": "string",
      "enum": ["3", "4", "5", "6", "7", "8", "9", "10", "11"],
      "description": "Grado escolar al que corresponde la pregunta. Opcional."
    },
    "prueba": {
      "type": "string",
      "enum": ["saber11", "evaluar_para_avanzar"],
      "description": "Programa de evaluación de origen. Opcional; el catálogo puede ampliarse en futuras versiones menores."
    },
    "procedencia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contenido": { "$ref": "#/$defs/nivelProcedencia" },
        "clasificacion": { "$ref": "#/$defs/nivelProcedencia" },
        "respuesta_correcta": { "$ref": "#/$defs/nivelProcedencia" }
      },
      "description": "Origen de cada bloque de la pregunta: contenido (contexto/enunciado/opciones), clasificacion (los 6 campos de metadata pedagógica) y respuesta_correcta (qué opción es la correcta). Ausencia = origen no declarado. Opcional."
    },
    "verificado": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contenido": { "type": "boolean" },
        "clasificacion": { "type": "boolean" },
        "respuesta_correcta": { "type": "boolean" }
      },
      "description": "Si un humano confirmó la exactitud de cada bloque, independientemente de su procedencia. Opcional."
    },
    "fuentes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contenido": { "type": "string", "minLength": 1 },
        "clasificacion": { "type": "string", "minLength": 1 },
        "respuesta_correcta": { "type": "string", "minLength": 1 }
      },
      "description": "Nombre de archivo PDF (dentro de fuentes/, sin ruta) del documento del que se extrajo cada bloque. Opcional, y solo tiene sentido para bloques con procedencia oficial o extraida_oficial."
    }
  },
  "$defs": {
    "nivelProcedencia": {
      "type": "string",
      "enum": ["oficial", "extraido_oficial", "ia_generada"]
    },
    "bloque": {
      "oneOf": [
        {
          "type": "object",
          "required": ["tipo", "texto"],
          "additionalProperties": false,
          "properties": {
            "tipo": { "const": "texto" },
            "texto": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["tipo", "archivo"],
          "additionalProperties": false,
          "properties": {
            "tipo": { "const": "imagen" },
            "archivo": {
              "type": "string",
              "minLength": 1,
              "description": "Nombre de archivo dentro de imagenes/, sin ruta."
            },
            "descripcion_accesible": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["tipo", "encabezados", "filas"],
          "additionalProperties": false,
          "properties": {
            "tipo": { "const": "tabla" },
            "encabezados": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "filas": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              },
              "description": "Cada fila debe tener el mismo número de columnas que encabezados (invariante validada por validador/validar.js, no expresable en JSON Schema puro)."
            }
          }
        }
      ]
    },
    "opcion": {
      "type": "object",
      "required": ["id", "contenido", "es_correcta", "justificacion"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contenido": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bloque" }
        },
        "es_correcta": { "type": "boolean" },
        "justificacion": {
          "type": "string",
          "minLength": 1,
          "description": "Específica de esta opción, correcta o incorrecta. Nunca una explicación general compartida."
        },
        "procedencia_justificacion": {
          "$ref": "#/$defs/nivelProcedencia",
          "description": "Origen de esta justificación en particular. Opcional; permite que una opción tenga retroalimentación oficial mientras las demás siguen siendo generadas por IA."
        },
        "justificacion_verificada": {
          "type": "boolean",
          "description": "Si un humano confirmó la exactitud de esta justificación. Opcional."
        }
      }
    }
  }
}
